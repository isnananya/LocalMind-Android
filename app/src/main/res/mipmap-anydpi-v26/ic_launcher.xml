<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标（Android 8+）。

    现行图标是用户提供的「新图标」：一张蓝紫渐变玻璃质感的圆角方形，
    主体是一个卡通星球 / 头盔形象（带面罩、两只眼睛、行星环），
    左上角一个对话气泡、右上角一颗四角星。它本身已经带圆角和渐变背景，
    所以背景层设为透明，把整张图作为前景层铺满 108dp 即可。

    旧版图标（小柠捐赠的那张）的致谢见「我的 → 关于 → 旧版本图标捐赠者」。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:color="@android:color/transparent" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
